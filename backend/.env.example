# ==========================================================
# ContextForge Backend Environment Example
# DO NOT put real secrets in this file.
# Copy this file to .env and fill in real values locally.
# ==========================================================

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6

OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini fallback
LLM_PRIMARY_PROVIDER=openai
LLM_FALLBACK_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.7-flash

# JWT Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=contextforge_documents

# Uploads / RAG
UPLOAD_DIR=uploads
MAX_PDF_SIZE_MB=10

RAG_SCORE_THRESHOLD=0.45
RAG_TOP_K=5
RAG_CHUNK_SIZE=2500
RAG_CHUNK_OVERLAP=300

# n8n
N8N_ACTION_WEBHOOK_URL=http://localhost:5678/webhook/contextforge-action
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_SECONDS=30

# Production frontend origin
CONTEXTFORGE_ALLOWED_ORIGINS=http://localhost:5173